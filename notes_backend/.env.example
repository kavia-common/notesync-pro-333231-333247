# NoteSync Pro Backend - Environment Variables
# Copy this file to .env and update values for your environment.

# Server
PORT=3010
HOST=0.0.0.0
UVICORN_HOST=0.0.0.0
UVICORN_WORKERS=1

# Database connection (notes_database container)
# These should match the PostgreSQL container configuration.
# POSTGRES_URL takes precedence if set; otherwise, individual vars are used.
# NOTE: Do not assume what these variables contain based on their names - use as provided.
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000
POSTGRES_HOST=localhost

# JWT Configuration
# IMPORTANT: Change JWT_SECRET in production!
JWT_SECRET=notesync-dev-secret-change-in-production
JWT_EXPIRATION_HOURS=24

# CORS - comma-separated list of allowed origins
# Must include the frontend preview URL
ALLOWED_ORIGINS=https://vscode-internal-41430-beta.beta01.cloud.kavia.ai:3000,http://localhost:3000,http://localhost:4000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
